# Copy this file to .env and fill in real values. .env is git-ignored.

# Gmail SMTP — use an App Password (https://myaccount.google.com/apppasswords),
# never your main Google account password.
GMAIL_ADDRESS=your.name@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where the report email gets sent (usually yourself).
REPORT_RECIPIENT=your.name@gmail.com

# Comma-separated recipients for the regional-team draft email (Etape 5bis).
# Only used to pre-fill the draft — draft_regional_email.py never sends automatically.
REGIONAL_TEAM_RECIPIENTS=olivia@example.com

# Optional: path to a CSV export of the "Competition" tab of the existing tracker,
# used by diff_existing.py to only surface real discrepancies.
COMPETITION_EXPORT_CSV=./data/competition_export.csv
